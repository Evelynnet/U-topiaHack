# Copy to web/.env.local and adjust.
DATABASE_URL=postgres://parking:parking@localhost:5432/parking

# Long random string (e.g. `openssl rand -base64 48`). Required.
AUTH_SECRET=change-me-to-a-long-random-string

# Where uploaded listing photos are stored (relative to web/ or absolute).
UPLOAD_DIR=./uploads

# AI provider for listing review. "none" for now; see docs/ROADMAP.md.
AI_PROVIDER=none
# AI_API_KEY=
