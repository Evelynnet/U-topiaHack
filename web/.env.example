DATABASE_URL=postgres://parking:parking@localhost:5432/parking
AUTH_SECRET=change-me-to-a-long-random-string
AI_PROVIDER=none

# Vercel Blob (listing photos). Create a PUBLIC Blob store in your Vercel project, then
# run `vercel env pull web/.env.local` (or paste the token here). Without it, photo upload
# fails but everything else works.
BLOB_READ_WRITE_TOKEN=

# Shows one-tap demo logins (demo@/owner@/admin@example.com) in the login pop-up.
# Local development only: leave unset or "false" in production. Read at build time.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
